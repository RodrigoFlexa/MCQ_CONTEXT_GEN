  "grupos": [
    {
      "manter": "02_05:c:C19",
      "remover": [
        "02_05:j:r1:003:2",
        "02_05:j:r1:008:2"
      ],
      "motivo": "Todas avaliam que a admissão de ar no espaço de vapor com hidrocarbonetos eleva a probabilidade de formação de mistura inflamável."
    },
    {
      "manter": "02_05:j:r1:005:2",
      "remover": [
        "02_05:j:r1:000:2",
        "02_05:j:r1:001:2",
        "02_05:j:r1:005:1"
      ],
      "motivo": "Todas cobram o mesmo princípio de que a drenagem deve ser tratada como interface de contenção de hidrocarbonetos, pois sua degradação pode levar à perda de contenção e incêndio."
    },
    {
      "manter": "02_05:j:r1:001:3",
      "remover": [
        "02_05:j:r1:000:3"
      ],
      "motivo": "Ambas avaliam a perda de segregação por interligação indevida entre drenagem fechada e aberta, fazendo hidrocarbonetos aparecerem na drenagem aberta."
    },
    {
      "manter": "02_05:j:r1:000:4:ref2",
      "remover": [
        "02_05:j:r1:006:2",
        "02_05:j:r1:000:1:ref2",
        "02_05:j:r1:001:1:ref2"
      ],
      "motivo": "Todas cobram que a segregação na origem é definida pelo potencial de hidrocarbonetos/gás inflamável, não apenas pela aparência aquosa, vazão ou destino final."
    },
    {
      "manter": "02_05:j:r1:007:3",
      "remover": [
        "02_05:j:r1:008:1",
        "02_05:j:r1:009:2"
      ],
      "motivo": "Todas avaliam o mesmo mecanismo de sifonamento em queda vertical esvaziando indevidamente o selo líquido."
    },
    {
      "manter": "02_05:j:r1:008:3",
      "remover": [
        "02_05:j:r1:007:4"
      ],
      "motivo": "Ambas avaliam que os setpoints de nível do vaso a jusante devem preservar a submersão do downcomer e o selo líquido entre sistemas."
    },
    {
      "manter": "02_05:c:C6",
      "remover": [
        "02_05:j:r1:016:4",
        "02_05:j:r1:017:2"
      ],
      "motivo": "Todas cobram que não se pode presumir compatibilidade de armazenamento só por ser hidrocarboneto, porque composição e volatilidade mudam o comportamento de vapores do tanque."
    },
    {
      "manter": "02_05:j:r1:014:3",
      "remover": [
        "02_05:j:r1:015:3",
        "02_05:j:r1:027:3"
      ],
      "motivo": "Todas avaliam que variações correlatas de nível/volume entre tanques indicam comunicação hidráulica indesejada entre eles."
    },
    {
      "manter": "02_05:c:C13:ref",
      "remover": [
        "02_05:j:r1:020:4:ref"
      ],
      "motivo": "Ambas cobram que pressão normal no espaço de vapor não garante inertização se o teor de oxigênio do gás inerte estiver alto."
    },
    {
      "manter": "02_05:c:C14:ref",
      "remover": [
        "02_05:j:r1:014:2:ref"
      ],
      "motivo": "Ambas avaliam que a água que sai do slop não está automaticamente em especificação final e pode exigir novo tratamento."
    },
    {
      "manter": "02_05:j:r1:011:2:ref",
      "remover": [
        "02_05:c:C15:ref",
        "02_05:j:r1:010:1:ref",
        "02_05:j:r1:011:1:ref",
        "02_05:j:r1:011:3:ref",
        "02_05:j:r1:011:4:ref",
        "02_05:j:r1:012:4:ref"
      ],
      "motivo": "Todas cobram o mesmo princípio de que a contrapressão na saída de água do hidrociclone participa do balanço hidráulico, controla a partilha entre saídas e afeta a eficiência de separação."
    },
    {
      "manter": "02_05:j:r1:004:3:ref",
      "remover": [
        "02_05:j:r1:026:3",
        "02_05:j:r1:006:3:ref"
      ],
      "motivo": "Todas avaliam a necessidade de garantir o encaminhamento hidráulico correto da drenagem e evitar desvio inadvertido para overboard."
    },
    {
      "manter": "02_05:j:r1:005:3:ref2",
      "remover": [
        "02_05:j:r1:006:4:ref2"
      ],
      "motivo": "Ambas pedem a mesma informação nos desenhos: interfaces entre alta e baixa pressão e seus dispositivos de proteção."
    },
    {
      "manter": "02_05:j:r1:008:4:ref2",
      "remover": [
        "02_05:j:r1:006:1:ref2"
      ],
      "motivo": "Ambas avaliam que obstrução pode alterar o nível local e romper a coluna líquida contínua do selo, permitindo comunicação gasosa."
    },
    {
      "manter": "02_05:j:r1:019:1:ref",
      "remover": [
        "02_05:j:r1:018:1:ref",
        "02_05:j:r1:018:2:ref",
        "02_05:j:r1:018:4:ref"
      ],
      "motivo": "Todas avaliam que, em interligação temporária entre tanques, a falta de estanqueidade das válvulas permite migração de inventário mesmo com bomba parada e válvulas fechadas."
    },
    {
      "manter": "02_05:j:r1:027:1:ref",
      "remover": [
        "02_05:j:r1:028:3:ref",
        "02_05:j:r1:029:1:ref",
        "02_05:j:r1:029:3:ref"
      ],
      "motivo": "Todas cobram que a passagem de serviço deve registrar a razão da restrição temporária e o uso permitido do header, não apenas o alinhamento momentâneo."
    }
  ]
}
  "grupos": [
    {
      "manter": "09_02:c:C10",
      "remover": [
        "09_02:j:r1:002:2"
      ],
      "motivo": "Ambas cobram que deformação dimensional do gancho fora da tolerância do fabricante reprova o componente mesmo sem trinca visível."
    },
    {
      "manter": "09_02:c:C13",
      "remover": [
        "09_02:j:r1:008:3"
      ],
      "motivo": "Ambas cobram inspeção física do eslingamento montado por terceiros antes do içamento."
    },
    {
      "manter": "09_02:c:C14",
      "remover": [
        "09_02:j:r1:019:2",
        "09_02:j:r1:023:2"
      ],
      "motivo": "Todas cobram o encadeamento entre estiva/preparo/roteiro e sequência de retirada para evitar remanejo e cruzamento de cargas."
    },
    {
      "manter": "09_02:c:C27",
      "remover": [
        "09_02:c:C17",
        "09_02:j:r1:020:4"
      ],
      "motivo": "Todas cobram comando único da manobra, mesmo com equipes ou pessoas em ambas as extremidades."
    },
    {
      "manter": "09_02:c:C22",
      "remover": [
        "09_02:j:r1:021:2"
      ],
      "motivo": "Ambas cobram confirmações incrementais na aproximação de blind lift com folga estreita."
    },
    {
      "manter": "09_02:c:C25",
      "remover": [
        "09_02:c:C24",
        "09_02:c:C29",
        "09_02:j:r1:022:3"
      ],
      "motivo": "Todas cobram que a zona de exclusão siga a trajetória real/provável da carga e seus balanços/pontos de enroscamento, não só a vertical do gancho."
    },
    {
      "manter": "09_02:j:r1:005:4",
      "remover": [
        "09_02:c:C6",
        "09_02:c:C7",
        "09_02:j:r1:001:4",
        "09_02:j:r1:007:3",
        "09_02:j:r1:011:3",
        "09_02:j:r1:011:4"
      ],
      "motivo": "Todas exigem verificação dinâmica por fases do rigging em operações offshore/subsea, especialmente na entrada na água e demais fases críticas."
    },
    {
      "manter": "09_02:c:C2:ref",
      "remover": [
        "09_02:c:C4",
        "09_02:j:r1:006:3"
      ],
      "motivo": "Todas cobram que a aprovação do rigging dependa da configuração/condição real do arranjo e da distribuição de esforços no sistema, não da marcação isolada de cada peça."
    },
    {
      "manter": "09_02:j:r1:004:2",
      "remover": [
        "09_02:j:r1:000:4"
      ],
      "motivo": "Ambas cobram que o aumento do raio reduz a capacidade disponível do guindaste."
    },
    {
      "manter": "09_02:c:C1:ref",
      "remover": [
        "09_02:c:C26:ref",
        "09_02:c:C28:ref",
        "09_02:j:r1:006:1:ref"
      ],
      "motivo": "Todas cobram que rigidez relativa diferente altera a distribuição real de esforços e impede assumir divisão igual de carga."
    },
    {
      "manter": "09_02:c:C5",
      "remover": [
        "09_02:j:r1:007:2"
      ],
      "motivo": "Ambas cobram que a folga entre componentes gera fechamento brusco do caminho de carga e sobrecarga localizada."
    },
    {
      "manter": "09_02:j:r1:007:4",
      "remover": [
        "09_02:j:r1:001:3"
      ],
      "motivo": "Ambas cobram que mar mais severo/movimento relativo aumenta as cargas dinâmicas do sistema."
    },
    {
      "manter": "09_02:j:r1:005:3:ref2",
      "remover": [
        "09_02:j:r1:005:1:ref2"
      ],
      "motivo": "Ambas cobram que a transferência entre unidades fica mais sensível pelo movimento relativo entre embarcação e instalação."
    },
    {
      "manter": "09_02:j:r1:008:4:ref",
      "remover": [
        "09_02:j:r1:008:1:ref"
      ],
      "motivo": "São a mesma pergunta sobre o uso do indicador de peso para conferir compatibilidade com a faixa operacional do guindaste."
    },
    {
      "manter": "09_02:j:r1:018:2:ref2",
      "remover": [
        "09_02:c:C20:ref2",
        "09_02:j:r1:018:1:ref2"
      ],
      "motivo": "Todas cobram que a toolbox/JSA alinhe a tarefa real, comunicações, posições seguras, tag lines e critérios/contingências antes da manobra."
    },
    {
      "manter": "09_02:c:C12:ref",
      "remover": [
        "09_02:j:r1:013:2"
      ],
      "motivo": "Ambas cobram apuração da causa do alarme/falha de proteção antes de bypass ou continuidade."
    },
    {
      "manter": "09_02:c:C30:ref",
      "remover": [
        "09_02:j:r1:007:1:ref"
      ],
      "motivo": "Ambas cobram a verificação do travamento correto do pino da manilha."
    },
    {
      "manter": "09_02:c:C19:ref2",
      "remover": [
        "09_02:j:r1:022:4:ref2"
      ],
      "motivo": "Ambas cobram a necessidade de protocolo pré-definido para perda de comunicação no rádio."
    },
    {
      "manter": "09_02:j:r1:021:3:ref",
      "remover": [
        "09_02:j:r1:020:3:ref"
      ],
      "motivo": "Ambas cobram identificação clara de emissor e destinatário no rádio para não confundir falas de apoio com comando ao operador."
    },
    {
      "manter": "09_02:j:r1:014:4:ref",
      "remover": [
        "09_02:j:r1:014:3:ref",
        "09_02:j:r1:015:2:ref"
      ],
      "motivo": "Todas cobram teste completo após reparo/remontagem em terra antes do retorno ao serviço."
    },
    {
      "manter": "09_02:j:r1:015:1:ref2",
      "remover": [
        "09_02:j:r1:015:3:ref2"
      ],
      "motivo": "Ambas cobram rastreabilidade inequívoca entre peça física e histórico/certificados após reparo."
    },
    {
      "manter": "09_02:j:r1:017:2:ref",
      "remover": [
        "09_02:j:r1:016:3:ref",
        "09_02:j:r1:017:1:ref",
        "09_02:c:C18:ref2"
      ],
      "motivo": "Todas cobram a mesma divisão por fase: o operador conduz o trecho intermediário estável e o sinaleiro concentra retirada e pouso pela leitura local."
    },
    {
      "manter": "09_02:j:r1:023:3:ref2",
      "remover": [
        "09_02:j:r1:019:4:ref2"
      ],
      "motivo": "Ambas cobram que restrições operacionais da unidade receptora alimentem o planejamento logístico antes do embarque/designação do apoio."
    },
    {
      "manter": "09_02:j:r1:025:1:ref",
      "remover": [
        "09_02:j:r1:024:1:ref",
        "09_02:j:r1:024:4:ref",
        "09_02:j:r1:025:3:ref",
        "09_02:j:r1:025:4:ref",
        "09_02:j:r1:026:1:ref"
      ],
      "motivo": "Todas cobram separar queda de carga de colapso de guindaste porque têm mecanismos causais e barreiras diferentes."
    },
    {
      "manter": "09_02:j:r1:012:2:ref2",
      "remover": [
        "09_02:j:r1:011:2:ref2",
        "09_02:j:r1:012:3:ref2"
      ],
      "motivo": "Todas cobram que o cabo e sua fixação no tambor têm modos de falha próprios e precisam de verificação separada."
    }
  ]
}
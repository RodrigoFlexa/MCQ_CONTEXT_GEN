  "grupos": [
    {
      "manter": "03_03:c:C13",
      "remover": [
        "03_03:j:r1:021:1"
      ],
      "motivo": "Ambas cobram que a adequação da proteção anticorrosiva depende do fluido efetivamente em contato com o metal, e Q2 é a aplicação mais específica."
    },
    {
      "manter": "03_03:j:r1:007:3",
      "remover": [
        "03_03:c:C4:forte_cob",
        "03_03:j:r1:013:4:forte_cob",
        "03_03:j:r1:015:2:forte_cob"
      ],
      "motivo": "Todas avaliam a reposição do espaço de vapor por gás inerte durante a descarga, seja pela função normal seja pelo diagnóstico da sua insuficiência."
    },
    {
      "manter": "03_03:j:r1:002:3:ref",
      "remover": [
        "03_03:j:r1:002:1:forte_cob"
      ],
      "motivo": "As duas testam que desviar/armazenar corrente em tanque de função diferente só é aceitável dentro das premissas avaliadas de composição, condição e duração."
    },
    {
      "manter": "03_03:c:C15:forte_cob",
      "remover": [
        "03_03:j:r1:018:4:forte_cob"
      ],
      "motivo": "Ambas cobram que redistribuições espaciais com assimetria transversal de massa podem introduzir solicitação torsional no casco."
    },
    {
      "manter": "03_03:c:C3:forte_cob",
      "remover": [
        "03_03:j:r1:014:3:forte_cob"
      ],
      "motivo": "As duas avaliam que dano estrutural por sobrepressão exige bloqueio do vent/alívio somado à perda da barreira de alarme/resposta."
    },
    {
      "manter": "03_03:j:r1:002:3:forte_cob",
      "remover": [
        "03_03:j:r1:003:4:forte_cob"
      ],
      "motivo": "Ambas testam que trocar o header muda a trajetória hidráulica e as perdas de carga, alterando o desempenho da transferência."
    },
    {
      "manter": "03_03:j:r1:004:4:forte_cob",
      "remover": [
        "03_03:j:r1:000:1",
        "03_03:j:r1:000:3",
        "03_03:c:C21:forte_cob",
        "03_03:j:r1:004:1:forte_cob"
      ],
      "motivo": "Todas cobram comunicação hidráulica indevida entre tanques, tipicamente por válvula sem estanqueidade, como causa de inventário/nível incompatível e stripping inefetivo."
    },
    {
      "manter": "03_03:j:r1:007:1:forte_cob",
      "remover": [
        "03_03:j:r1:008:4:forte_cob"
      ],
      "motivo": "As duas avaliam que tanques parcialmente cheios por longos períodos mantêm grande espaço de vapor que pode tornar-se inflamável se entrar oxigênio."
    },
    {
      "manter": "03_03:j:r1:010:1:forte_cob",
      "remover": [
        "03_03:c:C2:forte_cob",
        "03_03:c:C5:forte_cob",
        "03_03:j:r1:009:4:forte_cob"
      ],
      "motivo": "Todas cobram a exigência de isolamento positivo e inequívoco do tanque em relação ao sistema de gás inerte para entrada, não bastando apenas válvulas fechadas."
    },
    {
      "manter": "03_03:j:r1:011:1:forte_cob",
      "remover": [
        "03_03:j:r1:010:2:forte_cob"
      ],
      "motivo": "Ambas tratam do mesmo ponto: usar linha associada ao gás inerte em função não prevista exige Gestão de Mudança por risco de comunicações inesperadas."
    },
    {
      "manter": "03_03:j:r1:012:2:forte_cob",
      "remover": [
        "03_03:j:r1:011:2:forte_cob"
      ],
      "motivo": "As duas avaliam que a proteção por alto O2 depende também de setpoint adequado ao modo operacional e da resposta prevista, não só de o alarme soar."
    },
    {
      "manter": "03_03:j:r1:022:1:forte_cob",
      "remover": [
        "03_03:j:r1:022:4:forte_cob",
        "03_03:j:r1:023:1:forte_cob",
        "03_03:j:r1:023:2:forte_cob",
        "03_03:j:r1:024:3:forte_cob"
      ],
      "motivo": "Todas cobram que falhas no controle de SRB elevam a geração de H2S, agravando simultaneamente toxicidade e corrosão/integridade."
    }
  ]

  "grupos": [
    {
      "manter": "07_03:j:r1:011:3:ref",
      "remover": [
        "07_03:c:C23"
      ],
      "motivo": "Ambas avaliam a necessidade de dar visibilidade própria ao backlog de inspeção estrutural e marítima para evitar que ele fique diluído no backlog geral e seja adiado repetidamente."
    },
    {
      "manter": "07_03:c:C6",
      "remover": [
        "07_03:j:r1:016:3:ref"
      ],
      "motivo": "As duas cobram o mesmo critério técnico de agrupar intervenções em campanha quando compartilham acesso, recursos especializados e a mesma indisponibilidade operacional."
    },
    {
      "manter": "07_03:j:r1:000:2:forte_cob",
      "remover": [
        "07_03:j:r1:000:4:forte_cob",
        "07_03:j:r1:001:3:forte_cob",
        "07_03:j:r1:001:4:forte_cob",
        "07_03:j:r1:002:3:forte_cob",
        "07_03:j:r1:002:4:forte_cob"
      ],
      "motivo": "Todas testam a mesma premissa de aplicabilidade do RBD direto: ele é adequado sem reparação e sem dependência relevante da ordem das falhas, perdendo adequação fora disso."
    },
    {
      "manter": "07_03:j:r1:007:1:forte_cob",
      "remover": [
        "07_03:j:r1:013:2"
      ],
      "motivo": "Ambas avaliam que o trabalho só se torna executável por meio de detalhamento progressivo da programação frente às restrições reais de execução."
    },
    {
      "manter": "07_03:c:C13:forte_cob",
      "remover": [
        "07_03:j:r1:027:4"
      ],
      "motivo": "As duas cobram o mesmo ponto de que teste local não basta para liberação; é necessária verificação funcional integrada das interfaces e da função no sistema."
    },
    {
      "manter": "07_03:j:r1:008:3:forte_cob",
      "remover": [
        "07_03:j:r1:007:2:forte_cob"
      ],
      "motivo": "Ambas avaliam a mesma falha de processo: sem integração entre plano mestre de manutenção e planejamento de produção, a urgência de curto prazo passa a dominar."
    },
    {
      "manter": "07_03:j:r1:010:4:forte_cob",
      "remover": [
        "07_03:j:r1:013:1:forte_cob",
        "07_03:j:r1:013:4:forte_cob"
      ],
      "motivo": "As três testam a mesma necessidade de uma definição simples e compartilhada para classificar ordens como vencidas, backlog ou diferidas."
    },
    {
      "manter": "07_03:c:C22:forte_cob",
      "remover": [
        "07_03:j:r1:014:2:forte_cob",
        "07_03:j:r1:016:4:forte_cob"
      ],
      "motivo": "Todas avaliam o mesmo gargalo em unidades envelhecidas: o problema está na capacidade de analisar e responder aos dados de inspeção, não em coletar ainda mais dados."
    },
    {
      "manter": "07_03:j:r1:017:1:forte_cob",
      "remover": [
        "07_03:j:r1:016:2:forte_cob"
      ],
      "motivo": "Ambas cobram a necessidade de um sistema consistente de codificação/classificação de falhas para usar dados de disponibilidade e confiabilidade na gestão de SCEs."
    },
    {
      "manter": "07_03:c:C3:forte_cob",
      "remover": [
        "07_03:c:C2:forte_cob"
      ],
      "motivo": "As duas avaliam que a queda do MTBF decorre da mudança do mecanismo de falha pelo novo regime/ambiente de serviço, e não de logística ou equipe de reparo."
    },
    {
      "manter": "07_03:j:r1:020:3:forte_cob",
      "remover": [
        "07_03:j:r1:019:1:forte_cob",
        "07_03:j:r1:019:4:forte_cob"
      ],
      "motivo": "As três cobram o mesmo princípio de diagnóstico: sinais de condição de turbogerador durante offloading devem ser comparados com referência obtida em regime de carga semelhante."
    },
    {
      "manter": "07_03:j:r1:021:4:forte_cob",
      "remover": [
        "07_03:j:r1:021:2:forte_cob"
      ],
      "motivo": "Ambas avaliam a necessidade de reexaminar eventos passados e verificar se recomendações anteriores eram adequadas e realmente foram encerradas para tratar recorrência."
    },
    {
      "manter": "07_03:j:r1:026:1:forte_cob",
      "remover": [
        "07_03:j:r1:024:2:forte_cob",
        "07_03:j:r1:024:4:forte_cob",
        "07_03:j:r1:025:1:forte_cob",
        "07_03:j:r1:025:3:forte_cob",
        "07_03:j:r1:026:4:forte_cob"
      ],
      "motivo": "Todas testam o mesmo conhecimento de que não basta usar indicadores, criticidade ou economia para definir técnica e intervalo; é preciso comprovar a eficácia real da intervenção sobre o modo de falha."
    }
  ]
}